# Copy to .env and set your own values.

# --- Auth (one username/password, signed session cookie) ---
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
SESSION_SECRET=change-me-too-a-long-random-string
# true when served over HTTPS (cookie becomes Secure); plain http needs false.
COOKIE_SECURE=false

# --- Database ---
DB_NAME=starter
DB_USER=starter
DB_PASSWORD=change-me-db

# --- The app's public origin; added to the API's CORS allow-list. ---
PUBLIC_URL=http://localhost:9000

# --- Frontend ---
# Leave empty to reach the API at <same host>:9100 (works for localhost, LAN and Tailscale).
# Set it when the API sits behind a reverse proxy on the same origin, e.g. https://starter.example.com
NEXT_PUBLIC_API_URL=
